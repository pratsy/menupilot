# OpenAI - used for the agent, translation/menu structuring, and embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Restaurant discovery uses OpenStreetMap (Nominatim + Overpass) - free, no key needed.
# Reviews are scraped from each restaurant's own website (testimonials/reviews page,
# or its homepage) - also free, no key needed.

# Foursquare Places API - reserved, not currently used.
# Note: Foursquare's Tips (reviews) endpoint is paid from the first call, no free
# tier, so it isn't wired in as the review source. https://foursquare.com/developer/
FOURSQUARE_API_KEY=

# Local storage
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma

# How long cached restaurant/menu data is considered fresh, in days
CACHE_FRESHNESS_DAYS=30
